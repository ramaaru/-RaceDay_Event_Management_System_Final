<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><nav class="navbar navbar-expand-lg navbar-dark rd-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Organiser dashboard</a></li>}@if(Context.Session.GetString("Role")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My enrolments</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li>}</ul><div class="d-flex gap-2 align-items-center">@if(Context.Session.GetInt32("UserID")!=null){<span class="text-white small">@Context.Session.GetString("FullName")</span><a class="btn btn-outline-light btn-sm" asp-controller="Profile" asp-action="Index">Profile</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-warning btn-sm">Logout</button></form>}else{<a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a><a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Register</a>}</div></div></div></nav><main class="container py-4"><partial name="_Messages"/>@RenderBody()</main><footer class="rd-footer py-4 mt-5"><div class="container d-flex justify-content-between"><span>RaceDay • Run your race</span><span>Race event management platform</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>