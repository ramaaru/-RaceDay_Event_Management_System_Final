@model EventViewModel
@{ViewData["Title"]="Event details";}<a asp-action="Index" class="text-decoration-none">← All events</a><div class="detail-hero mt-3">@if(Model.HasBanner){<img src="@Url.Action("Banner", "Events", new { id = Model.EventID })" alt="@Model.EventName banner" class="img-fluid rounded mb-4" style="max-height:360px;width:100%;object-fit:cover;" />}<span class="badge text-bg-warning">@Model.EventType • @Model.Distance km</span><h1 class="display-5 fw-bold mt-3">@Model.EventName</h1><p class="lead">@Model.Description</p><div class="row mt-4"><div class="col-md-4"><b>Date</b><div>@Model.EventDate.ToString("dddd, dd MMMM yyyy")</div></div><div class="col-md-4"><b>Location</b><div>@Model.Location</div></div><div class="col-md-4"><b>Status</b><div>@Model.Status</div></div></div></div>@if(Context.Session.GetString("Role")=="Participant"){<div class="form-shell mt-4"><h2>Join this event</h2>@if(Model.Categories.Count==0){<p class="text-secondary">No categories are available for this event yet.</p>}else{<form method="post" asp-action="Enrol" asp-route-id="@Model.EventID"><div class="mb-3"><label class="form-label" for="eventCategoryId">Category</label><select class="form-select" id="eventCategoryId" name="eventCategoryId" required>@foreach(var category in Model.Categories){<option value="@category.EventCategoryID">@(category.Category?.CategoryName??$"Category {category.CategoryID}") @if(category.EntryFee>0){<text> - @category.EntryFee.ToString("C2")</text>}</option>}</select></div><div class="mb-3"><label class="form-label" for="raceNumber">Race number (optional)</label><input class="form-control" id="raceNumber" name="raceNumber" /></div><button class="btn btn-primary">Join event</button></form>}</div>}else if(Context.Session.GetInt32("UserID")==null){<p class="mt-3"><a asp-controller="Account" asp-action="Login">Log in</a> to manage your RaceDay activity.</p>}
