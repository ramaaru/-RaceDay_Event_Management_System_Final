@model List<EventViewModel>
@{ViewData["Title"]="Events";}<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Upcoming events</h1><p class="text-secondary">Find your next challenge.</p></div>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-primary" asp-controller="Organiser" asp-action="Create">+ Create event</a>}</div><form method="get" class="row g-2 mb-4"><div class="col-md-6"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search event or location"/></div><div class="col-md-3"><select name="type" class="form-select"><option value="">All activities</option><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary w-100">Filter events</button></div></form><div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="event-card h-100">@if(e.HasBanner){<img src="@Url.Action("Banner", "Events", new { id = e.EventID })" alt="@e.EventName banner" class="img-fluid w-100 mb-3" style="height:180px;object-fit:cover;" />}<div class="event-ribbon">@e.EventType • @e.Distance km</div><h3>@e.EventName</h3><p>@e.Description</p><p>📍 @e.Location<br/>📅 @e.EventDate.ToString("dd MMM yyyy")</p><a class="btn btn-primary" asp-action="Details" asp-route-id="@e.EventID">View details</a></div></div>}@if(Model.Count==0){<p>No events found. Try changing your filters or check that the Part 2 API has events.</p>}</div>
