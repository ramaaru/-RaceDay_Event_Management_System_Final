@model List<EnrolmentViewModel>
@{ViewData["Title"]="Enter results";}<h1>Results entry</h1><p class="text-secondary">Enter results for enrolled participants after the event concludes.</p>@foreach(var x in Model){<div class="feature-card mb-3"><div class="d-flex justify-content-between"><div><h5>@(x.Participant??$"Participant {x.UserID}")</h5><p class="mb-2">Enrolment #@x.EnrolmentID · @x.EnrolmentStatus</p></div></div><form method="post" asp-action="AddResult"><input type="hidden" name="id" value="@ViewBag.EventId"/><input type="hidden" name="enrolmentId" value="@x.EnrolmentID"/><div class="row g-2"><div class="col-md-3"><label class="form-label">Finish time</label><input name="finishTime" type="time" step="1" class="form-control"/></div><div class="col-md-2"><label class="form-label">Position</label><input name="position" type="number" min="1" class="form-control"/></div><div class="col-md-2"><label class="form-label">Category position</label><input name="categoryPosition" type="number" min="1" class="form-control"/></div><div class="col-md-2"><label class="form-label">Pace</label><input name="pace" type="number" step="0.01" min="0" class="form-control"/></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-success">Publish result</button></div></div></form></div>}@if(Model.Count==0){<p>No enrolments found for this event.</p>}