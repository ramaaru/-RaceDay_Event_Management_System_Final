@model EventViewModel
<div class="form-shell wide"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control"/><span asp-validation-for="EventName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" class="form-control"/></div></div><div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Distance" class="form-label"></label><input asp-for="Distance" class="form-control"/><span asp-validation-for="Distance" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="StartLocation" class="form-label"></label><input asp-for="StartLocation" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="FinishLocation" class="form-label"></label><input asp-for="FinishLocation" class="form-control"/></div></div>@if(Model.EventID>0){<div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Closed</option><option>Completed</option></select></div>}<button class="btn btn-primary">Save event</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
