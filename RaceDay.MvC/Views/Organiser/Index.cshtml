@model List<EventViewModel>
@{ViewData["Title"]="Organiser dashboard";}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Organiser dashboard</h1>
        <p class="text-secondary">Manage your events and race-day operations.</p>
    </div>
    <a class="btn btn-warning" asp-action="Create">+ New event</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <span>Your events</span>
            <strong>@Model.Count</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <span>Upcoming</span>
            <strong>@Model.Count(e=>e.EventDate>=DateTime.Today)</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <span>Past events</span>
            <strong>@Model.Count(e=>e.EventDate<DateTime.Today)</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <span>Total enrolments</span>
            <strong>@Model.Sum(e=>e.TotalEnrolments)</strong>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Location</th>
                <th>Distance</th>
                <th>Enrolments</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var e in Model){
            <tr>
                <td class="fw-semibold">@e.EventName</td>
                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                <td>@e.Location</td>
                <td>@e.Distance km</td>
                <td>@e.TotalEnrolments</td>
                <td><span class="status-pill">@e.Status</span></td>
                <td>
                    <div class="d-flex gap-1 flex-wrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.EventID">Edit</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-id="@e.EventID">Enrolments</a>
                        <a class="btn btn-sm btn-outline-success" asp-action="Results" asp-route-id="@e.EventID">Results</a>
                        <form method="post" asp-action="Delete" asp-route-id="@e.EventID" onsubmit="return confirm('Delete this event?')">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>