@model List<EventViewModel>
@{ViewData["Title"]="Participant home";}<h1>Welcome to RaceDay</h1><p class="text-secondary">Upcoming events ready for your next challenge.</p><div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="event-card h-100"><div class="event-ribbon">@e.EventType • @e.Distance km</div><h3>@e.EventName</h3><p>📍 @e.Location<br/>📅 @e.EventDate.ToString("dd MMM yyyy")</p><a class="btn btn-primary" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">Event details</a></div></div>}</div><div class="mt-4 d-flex gap-2"><a class="btn btn-outline-primary" asp-action="MyEnrolments">My enrolments</a><a class="btn btn-outline-primary" asp-action="MyResults">My results</a></div>